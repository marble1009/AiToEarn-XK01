# =============================================================
# aiautoedit STAGING 环境 .env 模板
#
# 使用方式：
#   1. cp .env.staging.example .env
#   2. 把所有 __REPLACE_ME__ 替换为 staging 测试用的真实凭据
#      （**不要用生产 .env，凭据必须独立**）
#   3. APP_DOMAIN 必须为 staging.aiautoedit.art
#
# 与生产 .env.deploy.template 的关键区别：
#   - APP_DOMAIN=staging.aiautoedit.art
#   - JWT_SECRET / INTERNAL_TOKEN 用与生产**不同**的串（避免测试 token 触达生产）
#   - 所有 AI/平台 Key 建议用 staging 专用 key（如阿里百炼可申请独立子账号）
#   - MAIL_USER / MAIL_PASS 用专门的测试邮箱（不要用 aitoearn@aiautoedit.art）
# =============================================================

NODE_ENV=production
APP_ENV=staging
APP_DOMAIN=staging.aiautoedit.art

# ---- JWT / 内部通信 token（与生产**完全不同**）----
JWT_SECRET=__REPLACE_ME_STAGING__
INTERNAL_TOKEN=__REPLACE_ME_STAGING__

# ---- MongoDB ----
# staging 建议复用生产 MongoDB 但用独立 db name：aitoearn_staging
# 或自建 mongo 容器：mongodb://admin:password@mongodb:27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=__REPLACE_ME_STAGING__
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=__REPLACE_ME_STAGING__

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_ME_STAGING__

# ---- RustFS ----
RUSTFS_ACCESS_KEY=__REPLACE_ME_STAGING__
RUSTFS_SECRET_KEY=__REPLACE_ME_STAGING__
# staging 一般用 9010 端口公开
PUBLIC_ASSETS_HOST=https://staging.aiautoedit.art/oss
PUBLIC_CDN_HOST=https://staging.aiautoedit.art/oss

# ---- 邮件 (SMTP，staging 用专门测试邮箱) ----
# 推荐：Mailtrap / MailHog 之类的测试 SMTP 中转
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=__REPLACE_ME_STAGING__
MAIL_PASS=__REPLACE_ME_STAGING__

# ---- 第三方 OAuth（**不要用生产 key**，留空表示该平台暂不接入 staging）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
KWAI_CLIENT_ID=
KWAI_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_TEST_AUTHORIZATION=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
WXPLAT_APP_ID=
WXPLAT_APP_SECRET=
WXPLAT_ENCODING_AES_KEY=
# 抖音 staging 单独申请的应用（不要用生产的 awssuej5w...）
DOYIN_CLIENT_ID=__REPLACE_ME_STAGING__
DOYIN_CLIENT_SECRET=__REPLACE_ME_STAGING__

# ---- 阿里云短信（staging 一般不发短信，留空）----
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=

# ---- AI 通道 ----
# 文本主通道：minimax-M3（**用 staging 专用 key**）
MINIMAX_API_KEY=__REPLACE_ME_STAGING__
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 图像/视频主通道：阿里百炼（**用 staging 专用 key**）
DASHSCOPE_API_KEY=__REPLACE_ME_STAGING__
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# OpenAI 兼容（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=__REPLACE_ME_STAGING__
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 文本兜底
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_NVIDIA_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_KEY_PAIRS=[]
GEMINI_LOCATION=us-central1
VOLCENGINE_API_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_VOD_SPACE_NAME=

# ---- Relay 中转（staging 一般不开，留空）----
RELAY_SERVER_URL=
RELAY_API_KEY=
RELAY_CALLBACK_URL=https://staging.aiautoedit.art/api/plat/relay-callback

# ---- 镜像注册中心 ----
IMAGE_REGISTRY=ghcr.io/marble1009
