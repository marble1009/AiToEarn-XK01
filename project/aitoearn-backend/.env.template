# ================================================================
# AiToEarn 后端本地开发环境变量
# ================================================================
# 使用方法：复制此文件为 .env.local，然后填入您的真实凭据
# 启动命令：先在项目根目录 docker compose up mongodb redis rustfs -d
#           然后在 aitoearn-backend 目录执行 pnpm nx serve aitoearn-server
# ================================================================

# ---- 应用域名 ----
# 本地开发用 localhost，生产部署时改为真实域名（如 aitoearn.cn 或 aitoearn.ai）
APP_DOMAIN=localhost
NODE_ENV=development

# ---- 数据库（默认使用 docker-compose 映射的端口）----
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=password

# ---- JWT / 内部通信 ----
JWT_SECRET=change-this-jwt-secret
INTERNAL_TOKEN=change-this-secret-token

# ---- AI 微服务 ----
AI_URL=http://localhost:3010

# ================================================================
# 以下为真实域名登录/注册所需的第三方服务凭据
# 请根据您的实际情况填写
# ================================================================

# ---- 邮件服务 (SMTP) ----
# 用于发送邮箱验证码，支持 AWS SES / 腾讯企业邮 / QQ 邮箱等
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ---- 阿里云短信（中国版手机验证码登录）----
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=

# ---- Google OAuth（国际版 Google 登录）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 以下为可选的第三方平台 OAuth ----
# 绑定社交媒体账号时需要，非必填
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
KWAI_CLIENT_ID=
KWAI_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
WXPLAT_APP_ID=
WXPLAT_APP_SECRET=
WXPLAT_ENCODING_AES_KEY=
DOYIN_CLIENT_ID=
DOYIN_CLIENT_SECRET=

# ---- Relay 中转（可选）----
RELAY_SERVER_URL=
RELAY_API_KEY=
RELAY_CALLBACK_URL=
