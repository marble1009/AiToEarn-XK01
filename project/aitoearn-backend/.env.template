# =============================================================
# aiautoedit 后端本地开发 .env 模板
# 与 .env.example 不同：本文件用于本地 docker compose / pnpm dev，
# 取值会覆盖根目录 .env.deploy.template
# =============================================================

NODE_ENV=development
APP_ENV=development
APP_DOMAIN=localhost

# 本地开发建议使用与 compose 一致的值
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_TOKEN=dev-internal-token-change-me

# 本地 Mongo / Redis：docker compose 已暴露端口
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27018
MONGODB_USERNAME=admin
MONGODB_PASSWORD=devpassword

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=devpassword

# 资产
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
PUBLIC_ASSETS_HOST=http://127.0.0.1:9010
PUBLIC_CDN_HOST=http://127.0.0.1/oss

# 邮件（开发可关闭，留空）
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# AI
OPENAI_API_KEY=__REPLACE_ME__
ANTHROPIC_API_KEY=__REPLACE_ME__
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 镜像注册中心
IMAGE_REGISTRY=ghcr.io/marble1009
