# =============================================================
# aiautoedit 后端 .env 模板
# 复制为 .env 后填入真实值，.env 不要提交到 git
# =============================================================

# ---- 运行环境 ----
NODE_ENV=production
APP_ENV=production
APP_DOMAIN=aiautoedit.art

# ---- JWT / 内部通信 token（必须为不可猜测的长字符串）----
# 生成方式：openssl rand -hex 48
JWT_SECRET=__REPLACE_ME__
INTERNAL_TOKEN=__REPLACE_ME__

# ---- 数据库 ----
# 优先使用完整 URI 形式（MongoDB Atlas 推荐）
# 样例：MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=xxx
MONGODB_URI=
# 以下为分字段回退（自建实例时使用）
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=__REPLACE_ME__

# ---- 缓存 / 队列 ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_ME__

# ---- 服务间通信（容器内网地址，compose 已预设）----
AI_URL=http://aitoearn-ai:3010
SERVER_URL=http://aitoearn-server:3002

# ---- 对象存储 (S3 兼容 / RustFS) ----
RUSTFS_ACCESS_KEY=__REPLACE_ME__
RUSTFS_SECRET_KEY=__REPLACE_ME__
PUBLIC_ASSETS_HOST=http://127.0.0.1:9010
PUBLIC_CDN_HOST=http://127.0.0.1/oss
# ASSETS_CONFIG 会在 compose 中自动拼接，无需手动改 JSON

# ---- 邮件 (SMTP) ----
# 推荐：AWS SES / 腾讯企业邮箱 / Postmark / Resend
MAIL_HOST=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USER=aitoearn@aiautoedit.art
MAIL_PASS=__REPLACE_ME__

# ---- 第三方 OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
KWAI_CLIENT_ID=
KWAI_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_TEST_AUTHORIZATION=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
WXPLAT_APP_ID=
WXPLAT_APP_SECRET=
WXPLAT_ENCODING_AES_KEY=
DOYIN_CLIENT_ID=__REPLACE_ME__
DOYIN_CLIENT_SECRET=__REPLACE_ME__

# ---- 阿里云短信（中国版登录，可选）----
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=

# ---- AI 服务密钥 ----
# 文本生成（minimax-M3）—— 主通道
MINIMAX_API_KEY=__REPLACE_ME__
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 阿里百炼 Wanxiang —— 图片 / 视频通道
DASHSCOPE_API_KEY=__REPLACE_ME__
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# OpenAI 兼容（兜底或可选使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=__REPLACE_ME__
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 文本兜底（DeepSeek，可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROK_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=
# JSON 数组，支持多 key 轮询：[{"apiKey":"k1","weight":1},{"apiKey":"k2","weight":1}]
GEMINI_KEY_PAIRS=[]
GEMINI_LOCATION=us-central1
AI_NVIDIA_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_VOD_SPACE_NAME=

# ---- Relay 中转（可选）----
# 中国版：RELAY_SERVER_URL=https://aitoearn.cn/api
# 国际版：RELAY_SERVER_URL=https://aitoearn.ai/api
RELAY_SERVER_URL=
RELAY_API_KEY=
RELAY_CALLBACK_URL=https://aiautoedit.art/api/plat/relay-callback

# ---- 镜像注册中心（CI 推送与 compose 拉取都用得到）----
IMAGE_REGISTRY=ghcr.io/marble1009
