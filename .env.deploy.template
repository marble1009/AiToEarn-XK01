# =============================================================
# aiautoedit 根目录 .env 模板（docker compose 部署用）
# 复制为 .env 后填入真实值
# =============================================================

# ---- 域名（与 nginx 证书 / server_name 一致）----
# 中国版填 aitoearn.cn，国际版填 aitoearn.ai，自部署填 aiautoedit.art
APP_DOMAIN=aiautoedit.art

# ---- JWT / 内部 token（用 openssl rand -hex 48 生成）----
JWT_SECRET=__REPLACE_ME__
INTERNAL_TOKEN=__REPLACE_ME__

# ---- MongoDB ----
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=__REPLACE_ME__

# ---- Redis ----
REDIS_PASSWORD=__REPLACE_ME__

# ---- RustFS ----
RUSTFS_ACCESS_KEY=__REPLACE_ME__
RUSTFS_SECRET_KEY=__REPLACE_ME__
PUBLIC_ASSETS_HOST=https://oss.aiautoedit.art
PUBLIC_CDN_HOST=https://cdn.aiautoedit.art

# ---- 邮件 (SMTP) ----
# AWS SES 示例：MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
# 腾讯企业邮箱示例：MAIL_HOST=smtp.exmail.qq.com, MAIL_PORT=465
MAIL_HOST=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USER=aitoearn@aiautoedit.art
MAIL_PASS=__REPLACE_ME__

# ---- Google OAuth（国际版登录）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 阿里云短信（中国版登录）----
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=

# ---- 第三方平台 OAuth（按需启用）----
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
KWAI_CLIENT_ID=
KWAI_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_TEST_AUTHORIZATION=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
WXPLAT_APP_ID=
WXPLAT_APP_SECRET=
WXPLAT_ENCODING_AES_KEY=
DOYIN_CLIENT_ID=__REPLACE_ME__
DOYIN_CLIENT_SECRET=__REPLACE_ME__

# ---- Relay 中转（可选）----
# 中国版：RELAY_SERVER_URL=https://aitoearn.cn/api
# 国际版：RELAY_SERVER_URL=https://aitoearn.ai/api
RELAY_SERVER_URL=
RELAY_API_KEY=
RELAY_CALLBACK_URL=https://aiautoedit.art/api/plat/relay-callback

# ---- AI 密钥 ----
# 文本主通道：minimax-M3
MINIMAX_API_KEY=__REPLACE_ME__
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 图像/视频主通道：阿里百炼 Wanxiang
DASHSCOPE_API_KEY=__REPLACE_ME__
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# OpenAI 兼容通道（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=__REPLACE_ME__
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 文本兜底（DeepSeek，可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_NVIDIA_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=
# 多 key 轮询：'[{"apiKey":"k1","weight":1}]'
GEMINI_KEY_PAIRS=[]
GEMINI_LOCATION=us-central1
VOLCENGINE_API_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_VOD_SPACE_NAME=

# ---- 镜像注册中心（CI 推送与 compose 拉取都用得到）----
IMAGE_REGISTRY=ghcr.io/marble1009
