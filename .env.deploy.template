# ================================================================
# AiToEarn Docker 部署环境变量
# ================================================================
# 使用方法：
#   1. 复制此文件到项目根目录并命名为 .env
#   2. 填入您的真实域名和凭据
#   3. 运行 docker compose up -d
# ================================================================

# ---- 您的域名 ----
# 中国版填 aitoearn.cn，国际版填 aitoearn.ai
APP_DOMAIN=aurastring.cloud

# ---- 邮件服务 (SMTP) ----
# 用于发送登录/注册验证码邮件
# AWS SES 示例:
#   MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
# 腾讯企业邮箱示例:
#   MAIL_HOST=smtp.exmail.qq.com
#   MAIL_PORT=465
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ---- Google OAuth（国际版需要）----
# 在 Google Cloud Console 创建 OAuth 2.0 客户端
# 已授权 JavaScript 来源: https://<APP_DOMAIN>
# 已授权重定向 URI: https://<APP_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 阿里云短信（中国版需要）----
# 用于手机号验证码登录/注册
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=

# ---- Relay 中转服务（可选）----
# RELAY_SERVER_URL=https://aitoearn.cn/api
# RELAY_API_KEY=
# RELAY_CALLBACK_URL=

# ---- AI 服务密钥（可选，用于 AI 功能）----
AI_NVIDIA_API_KEY=
# MiniMax Plus 统一大模型配置模板（中国区）：
# OPENAI_API_KEY=sk-cp-xxxxxx
# OPENAI_BASE_URL=https://api.minimaxi.com/v1
# ANTHROPIC_API_KEY=sk-cp-xxxxxx
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
